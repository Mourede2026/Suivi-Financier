/* =========================================================================
   SUIVI FINANCE ZS-DAA — Design system "registre de caisse"
   Un bureau de contrôle sombre, des fiches papier posées dessus,
   des tampons d'audit pour les verdicts Bon / Problème.
   ========================================================================= */

@import url('https://fonts.googleapis.com/css2?family=Zilla+Slab:wght@500;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;600&display=swap');

:root {
  /* Couleurs */
  --bureau: #16211C;
  --bureau-clair: #1E2E26;
  --papier: #F4EFE0;
  --papier-ombre: #E6DEC7;
  --encre: #1E2E26;
  --encre-douce: #4B5B50;
  --brass: #C79A3E;
  --brass-clair: #E4C069;
  --tampon-bon: #2E6E49;
  --tampon-probleme: #B23A2E;
  --ligne: #D8CFAF;
  --blanc: #FFFDF8;

  /* Typographie */
  --font-display: 'Zilla Slab', Georgia, serif;
  --font-body: 'IBM Plex Sans', system-ui, sans-serif;
  --font-mono: 'IBM Plex Mono', 'Courier New', monospace;

  /* Rythme */
  --radius: 3px;
  --ombre-fiche: 0 2px 0 var(--papier-ombre), 0 12px 24px -12px rgba(0,0,0,0.45);
}

* { box-sizing: border-box; }

html, body {
  margin: 0;
  padding: 0;
  background: var(--bureau);
  color: var(--encre);
  font-family: var(--font-body);
  -webkit-font-smoothing: antialiased;
}

body {
  background-image:
    radial-gradient(ellipse at top left, rgba(199,154,62,0.06), transparent 55%),
    repeating-linear-gradient(180deg, rgba(0,0,0,0.12) 0px, rgba(0,0,0,0.12) 1px, transparent 1px, transparent 3px);
  min-height: 100vh;
}

a { color: inherit; }

h1, h2, h3 {
  font-family: var(--font-display);
  font-weight: 700;
  margin: 0 0 0.3em 0;
  color: var(--encre);
}

.eyebrow {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--encre-douce);
}

/* ---------- Layout ---------- */

.ecran {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
}

.conteneur {
  max-width: 1100px;
  margin: 0 auto;
  padding: 32px 20px 80px;
}

.entete-app {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 28px;
  background: var(--bureau-clair);
  border-bottom: 1px solid rgba(199,154,62,0.25);
  position: sticky;
  top: 0;
  z-index: 20;
}

.entete-app .marque {
  display: flex;
  align-items: baseline;
  gap: 10px;
}

.entete-app .marque h1 {
  color: var(--papier);
  font-size: 1.25rem;
  margin: 0;
}

.entete-app .marque .eyebrow { color: var(--brass-clair); }

.entete-app .infos-session {
  display: flex;
  align-items: center;
  gap: 16px;
  color: var(--papier);
  font-family: var(--font-mono);
  font-size: 0.85rem;
}

/* ---------- Fiche (carte papier) ---------- */

.fiche {
  background: var(--papier);
  border-radius: var(--radius);
  box-shadow: var(--ombre-fiche);
  padding: 28px;
  margin-bottom: 20px;
}

.fiche-titre {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18px;
  padding-bottom: 14px;
  border-bottom: 2px solid var(--encre);
}

/* ---------- Formulaires ---------- */

label {
  display: block;
  font-family: var(--font-mono);
  font-size: 0.72rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--encre-douce);
  margin-bottom: 6px;
}

input, select, textarea {
  width: 100%;
  font-family: var(--font-body);
  font-size: 0.95rem;
  padding: 10px 12px;
  border: 1px solid var(--ligne);
  border-radius: var(--radius);
  background: var(--blanc);
  color: var(--encre);
}

input:focus, select:focus, textarea:focus {
  outline: 2px solid var(--brass);
  outline-offset: 1px;
  border-color: var(--brass);
}

input[type="number"] {
  font-family: var(--font-mono);
  text-align: right;
}

.champ { margin-bottom: 16px; }

.grille-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.grille-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px; }

@media (max-width: 640px) {
  .grille-2, .grille-3 { grid-template-columns: 1fr; }
}

/* ---------- Boutons ---------- */

button, .bouton {
  font-family: var(--font-body);
  font-weight: 600;
  font-size: 0.9rem;
  padding: 11px 20px;
  border-radius: var(--radius);
  border: 1px solid transparent;
  cursor: pointer;
  transition: transform 0.08s ease, box-shadow 0.08s ease;
}

button:active { transform: translateY(1px); }

.bouton-principal {
  background: var(--encre);
  color: var(--papier);
}
.bouton-principal:hover { background: #2B3E33; }

.bouton-brass {
  background: var(--brass);
  color: var(--bureau);
}
.bouton-brass:hover { background: var(--brass-clair); }

.bouton-discret {
  background: transparent;
  color: var(--encre);
  border-color: var(--ligne);
}
.bouton-discret:hover { background: rgba(0,0,0,0.04); }

.bouton-pleine-largeur { width: 100%; }

button:disabled { opacity: 0.5; cursor: not-allowed; }

/* ---------- Tampon d'audit (Bon / Problème) ---------- */

.tampon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-mono);
  font-weight: 600;
  font-size: 0.72rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  padding: 5px 12px;
  border: 2px solid currentColor;
  border-radius: 999px;
  transform: rotate(-2deg);
  white-space: nowrap;
}

.tampon-bon { color: var(--tampon-bon); background: rgba(46,110,73,0.08); }
.tampon-probleme { color: var(--tampon-probleme); background: rgba(178,58,46,0.08); transform: rotate(2deg); }
.tampon-attente { color: var(--encre-douce); background: rgba(75,91,80,0.08); border-style: dashed; transform: rotate(0deg); }

/* ---------- Tables ---------- */

table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.88rem;
}

th {
  text-align: left;
  font-family: var(--font-mono);
  font-size: 0.7rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--encre-douce);
  padding: 8px 10px;
  border-bottom: 2px solid var(--encre);
}

td {
  padding: 10px;
  border-bottom: 1px solid var(--ligne);
  font-family: var(--font-mono);
}

td.texte { font-family: var(--font-body); }

tr:hover td { background: rgba(199,154,62,0.06); }

/* ---------- Cartes centre (grille de collecte) ---------- */

.grille-centres {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 14px;
}

.carte-centre {
  background: var(--blanc);
  border: 1px solid var(--ligne);
  border-radius: var(--radius);
  padding: 16px;
  cursor: pointer;
  transition: border-color 0.12s ease, transform 0.12s ease;
}

.carte-centre:hover { border-color: var(--brass); transform: translateY(-1px); }

.carte-centre h3 { font-size: 1rem; margin-bottom: 4px; }
.carte-centre .commune { font-family: var(--font-mono); font-size: 0.72rem; color: var(--encre-douce); margin-bottom: 10px; }

/* ---------- Onglets ---------- */

.onglets {
  display: flex;
  gap: 4px;
  border-bottom: 1px solid rgba(199,154,62,0.25);
  padding: 0 28px;
  background: var(--bureau-clair);
}

.onglet {
  background: transparent;
  border: none;
  color: rgba(244,239,224,0.6);
  font-family: var(--font-body);
  font-weight: 600;
  padding: 14px 18px;
  border-bottom: 2px solid transparent;
  cursor: pointer;
}

.onglet.actif { color: var(--brass-clair); border-bottom-color: var(--brass); }

/* ---------- Sous-onglets (dans une fiche claire, ex. panneau centre) ---------- */

.sous-onglets {
  display: flex;
  gap: 4px;
  flex-wrap: wrap;
  border-bottom: 1px solid var(--ligne);
  margin-bottom: 18px;
}

.sous-onglet {
  background: transparent;
  border: none;
  border-bottom: 2px solid transparent;
  color: var(--encre-douce);
  font-family: var(--font-body);
  font-weight: 600;
  font-size: 0.88rem;
  padding: 10px 14px;
  cursor: pointer;
}

.sous-onglet.actif { color: var(--encre); border-bottom-color: var(--brass); }

/* ---------- Stat/KPI ---------- */

.rangee-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 14px; margin-bottom: 20px; }

.stat {
  background: var(--papier);
  border-radius: var(--radius);
  box-shadow: var(--ombre-fiche);
  padding: 18px 20px;
}

.stat .valeur { font-family: var(--font-mono); font-size: 1.8rem; font-weight: 600; color: var(--encre); }
.stat .libelle { font-family: var(--font-mono); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--encre-douce); }

/* ---------- Modale ---------- */

.fond-modale {
  position: fixed; inset: 0;
  background: rgba(15, 22, 18, 0.72);
  display: flex; align-items: center; justify-content: center;
  padding: 20px;
  z-index: 50;
}

.modale {
  background: var(--papier);
  border-radius: var(--radius);
  box-shadow: var(--ombre-fiche);
  max-width: 560px;
  width: 100%;
  max-height: 90vh;
  overflow-y: auto;
  padding: 28px;
}

/* ---------- Messages ---------- */

.message {
  padding: 12px 16px;
  border-radius: var(--radius);
  font-size: 0.88rem;
  margin-bottom: 16px;
  border-left: 3px solid;
}
.message-erreur { background: rgba(178,58,46,0.08); border-color: var(--tampon-probleme); color: var(--tampon-probleme); }
.message-succes { background: rgba(46,110,73,0.08); border-color: var(--tampon-bon); color: var(--tampon-bon); }

/* ---------- Utilitaires ---------- */

.flex-entre { display: flex; align-items: center; justify-content: space-between; }
.flex-gap { display: flex; align-items: center; gap: 10px; }
.mt-0 { margin-top: 0; }
.mb-0 { margin-bottom: 0; }
.texte-discret { color: var(--encre-douce); font-size: 0.85rem; }
.cache { display: none !important; }

::placeholder { color: #A9A08A; }

@media (max-width: 640px) {
  .entete-app { padding: 14px 16px; flex-direction: column; align-items: flex-start; gap: 10px; }
  .conteneur { padding: 20px 12px 60px; }
  .fiche { padding: 18px; }
  .onglets { padding: 0 12px; overflow-x: auto; }
}
